# Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# Every submission is always saved to contact_messages regardless — this is
# just an optional extra delivery path once VMA confirms a real CRM/webhook.
CONTACT_ENDPOINT=

# Comma-separated list of emails (must match an activated account) allowed to
# see /portal/mensajes — the "Hablemos" contact-form inbox. Everyone else
# with a login still gets the rest of /portal, just not this page. Empty by
# default, meaning nobody can see it yet — set this before relying on the
# inbox.
ADMIN_EMAILS=

# Public (inlined into the client bundle at build time — never put a secret
# here). Wompi merchant's public key, used by /precios' payment buttons
# (see src/lib/wompi.ts). When unset, every pricing card falls back to a
# "Escríbenos" link to /contacto instead of a broken checkout.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
