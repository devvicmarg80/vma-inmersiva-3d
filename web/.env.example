# Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# When unset, the route just logs submissions server-side.
CONTACT_ENDPOINT=

# Public (inlined into the client bundle at build time — never put a secret
# here). Wompi merchant's public key, used by /precios' payment buttons
# (see src/lib/wompi.ts). When unset, every pricing card falls back to a
# "Escríbenos" link to /contacto instead of a broken checkout.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
